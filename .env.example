# Copy to .env and fill in real values. Never commit .env.

# MySQL connection string used by Prisma (see prisma.config.ts)
DATABASE_URL="mysql://user:password@localhost:3306/university_of_wow"

# NextAuth
AUTH_SECRET="generate-with-npx-auth-secret"

# Anthropic Claude API (AI Help Assistant, section 9)
ANTHROPIC_API_KEY=""

# Optional email notifications (Resend or SMTP)
RESEND_API_KEY=""
